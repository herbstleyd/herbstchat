#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
  getent group herbstchat >/dev/null || addgroup --system herbstchat
  getent passwd herbstchat >/dev/null || adduser --system --ingroup herbstchat --home /var/lib/herbstchat --no-create-home --shell /usr/sbin/nologin herbstchat
  mkdir -p /var/lib/herbstchat
  chown herbstchat:herbstchat /var/lib/herbstchat; chmod 750 /var/lib/herbstchat
  if [ ! -f /etc/herbstchat/cert.pem ]; then
    echo "Herbstchat: erzeuge TLS-Zertifikat fuer chat.example.org ..."
    openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 3650 \
      -keyout /etc/herbstchat/key.pem -out /etc/herbstchat/cert.pem \
      -subj "/CN=chat.example.org" -addext "subjectAltName=DNS:chat.example.org" >/dev/null 2>&1
  fi
  chown root:herbstchat /etc/herbstchat /etc/herbstchat/key.pem /etc/herbstchat/cert.pem /etc/herbstchat/server.conf
  chmod 750 /etc/herbstchat; chmod 640 /etc/herbstchat/key.pem /etc/herbstchat/server.conf; chmod 644 /etc/herbstchat/cert.pem
  if grep -qE '^password_hash *= *$' /etc/herbstchat/server.conf; then
    PW=$(openssl rand -base64 18 | tr -d '/+=' | cut -c1-16)
    /usr/bin/herbstchat-server --set-admin-password --password "$PW" >/dev/null
    ( umask 077; printf 'Benutzer: admin\nPasswort: %s\n' "$PW" > /etc/herbstchat/admin-zugang.txt )
    chmod 600 /etc/herbstchat/admin-zugang.txt
    echo "=================================================================="
    echo " Herbstchat Admin-Website:  http://<Server-LAN-IP>:8088"
    echo " Benutzer: admin   Passwort: $PW"
    echo " (gespeichert in /etc/herbstchat/admin-zugang.txt)"
    echo "=================================================================="
  fi
  FP=$(openssl x509 -in /etc/herbstchat/cert.pem -noout -fingerprint -sha256 | cut -d= -f2)
  echo "Zertifikat-Fingerabdruck (SHA-256): $FP"
  echo "$FP" > /etc/herbstchat/zertifikat-fingerabdruck.txt; chmod 644 /etc/herbstchat/zertifikat-fingerabdruck.txt
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    systemctl enable herbstchat-server.service >/dev/null 2>&1 || true
    systemctl restart herbstchat-server.service || true
  fi
  echo "Herbstchat Server laeuft auf Port 47474/TCP (TLS). Bitte im Router weiterleiten."
fi
exit 0
